# Doxygen configuration for OPT4001
# Generated and maintained for unified API documentation.

PROJECT_NAME           = "OPT4001"
PROJECT_NUMBER         = "1.1.0"
PROJECT_BRIEF          = "Framework-neutral OPT4001 driver API documentation"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO

SHOW_INCLUDE_FILES     = YES
INLINE_INFO            = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
STRIP_CODE_COMMENTS    = NO

INPUT                  = README.md \
                         CHANGELOG.md \
                         CONTRIBUTING.md \
                         include/OPT4001 \
                         docs/README.md \
                         docs/integration/esp-idf.md \
                         docs/integration/driver-contracts.md \
                         docs/validation/hardware-validation-procedure.md \
                         docs/validation/release-checklist.md \
                         docs/validation/validation-status.md \
                         docs/reference/OPT4001_datasheet.md \
                         docs/reference/AN_light_detection.md \
                         docs/reference/AN_high_speed_resolution.md \
                         docs/reference/AN_picostar_package.md
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */.pio/* \
                         */.git/* \
                         */test/* \
                         */docs/doxygen/*
EXAMPLE_PATH           = examples/01_basic_bringup_cli

USE_MDFILE_AS_MAINPAGE = README.md
FULL_PATH_NAMES        = NO
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO

WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
QUIET                  = YES
